# Local PostgreSQL/WASM regression test dependency
test/backend/node_modules/

# sentry-native's crash database, created next to the working directory the
# app is launched from - so running a build from the repo root leaves it here.
.sentry-native/

# Python bytecode from tool/ scripts.
__pycache__/

# Microsoft Store upload images, generated by tool/generate_store_images.py.
# Regenerate rather than commit: they are derived from assets/icons/app_icon.png.
docs/microsoft-store-images/
