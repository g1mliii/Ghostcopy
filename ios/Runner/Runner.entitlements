<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the share extension: it writes the shared attachments
	     into this container and the app reads them back out. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ghostcopy.app</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple. The App ID has the capability enabled as a
	     primary App ID; without this key the authorization sheet fails. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- The name the user gave the phone ("Subaig's iPhone") rather than
	     its model. Since iOS 16 UIDevice.name returns only the model
	     without this, which Apple grants on request; granted for
	     com.ghostcopy.ghostcopy. Shown to the user in their own device list
	     and on the chips, and nowhere else - crash reports carry no device
	     name (sendDefaultPii is off). -->
	<key>com.apple.developer.device-information.user-assigned-device-name</key>
	<true/>
</dict>
</plist>
