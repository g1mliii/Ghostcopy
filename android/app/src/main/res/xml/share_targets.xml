<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share target for the shortcut MainActivity.publishShareShortcut
     publishes. */* matches the activity's SEND filters. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.ghostcopy.ghostcopy.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.ghostcopy.ghostcopy.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
