<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tint applied behind the (alpha-only) status bar icon and to the app name
        in the notification shade. Matches GhostColors.primary.

        This was #5865F2 - Discord's Blurple, which the accent used to be a
        copy of. The Flutter theme moved off it; this did not, so every
        notification was still tinted with it.
    -->
    <color name="notification_accent">#FF6670FF</color>

    <!-- GhostColors.background. The splash and the window behind the Flutter
         UI both use it, so there is no lighter frame on either side of the
         first frame. -->
    <color name="ghost_background">#FF0F0F13</color>

    <!-- Adaptive icon background layer. GhostColors.primary: the launcher
         masks this to its own shape, so it is a flat fill rather than a tile
         with corners of its own. -->
    <color name="ghost_icon_background">#FF6670FF</color>
</resources>
