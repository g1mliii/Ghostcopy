<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark in both day and night. The app has a single dark theme, so the
         Light parent this used to carry meant a white splash and a light
         window behind the Flutter UI whenever the phone was not in dark
         mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has
         started. This determines the colour of the window while the Flutter UI
         initialises, and behind it while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ghost_background</item>
    </style>
</resources>
