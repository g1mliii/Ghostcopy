<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed; see Release.entitlements for why. The network and
	     user-selected-file entitlements were sandbox permissions and went
	     with it. -->

	<!-- Stays: this one is a hardened-runtime entitlement, not a sandbox one.
	     A Flutter debug build runs Dart under JIT and cannot start without
	     it. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.ghostcopy.ghostcopy</string>
	</array>
	<!-- No APNs entitlement here, deliberately: it is restricted, so a local
	     `flutter run -d macos` would need a development profile with Push
	     before it could even launch. Debug builds stay on realtime; test push
	     with a release build. -->
</dict>
</plist>
