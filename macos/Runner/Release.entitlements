<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed. GhostCopy is distributed with Developer ID and
	     notarization, not through the Mac App Store, and the sandbox is
	     mandatory only for the store. Leaving it on bought nothing here and
	     cost two things: Sparkle needs an XPC service bundle and extra
	     entitlements to update a sandboxed app, and launch-at-startup was
	     never verified working under it.

	     The network and user-selected-file entitlements went with it - both
	     are sandbox permissions, and outside the sandbox they do nothing.

	     keychain-access-groups stays. flutter_secure_storage sets
	     kSecUseDataProtectionKeychain on macOS (MacOsOptions defaults it to
	     true and nothing here overrides it), which needs this entitlement to
	     address its items - sandbox or no sandbox. It also keeps the group
	     identical across the change, so the stored passphrase is still found
	     afterwards rather than orphaned the way an iOS accessibility change
	     once orphaned it. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.ghostcopy.ghostcopy</string>
	</array>
	<!-- Sign in with Apple, for the native sheet. A restricted entitlement:
	     the provisioning profile must authorize it or the app will not
	     launch, which verify-app.py checks before notarizing. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
